                            <i class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></i> Logout
                        </button>
                    </form>
                </li>
            </Authorized>
            <NotAuthorized>
                <li class="nav-item">
                    <NavLink class="nav-link collapsed" href="Account/Register">
                        <span class="bi bi-person-nav-menu"></span> Register
